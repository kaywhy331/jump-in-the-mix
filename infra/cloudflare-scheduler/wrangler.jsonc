{
  "name": "jump-in-the-mix-test-scheduler",
  "main": "index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_URL": "https://jump-in-the-mix-test.netlify.app" },
  "secrets": { "required": ["NETLIFY_WORKER_SECRET"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
