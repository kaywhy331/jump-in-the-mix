{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateEncryptedBackupsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::jump-in-the-mix-backups-602326733999-us-west-2/production/*",
      "Condition": {
        "StringEquals": {
          "s3:if-none-match": "*",
          "s3:x-amz-server-side-encryption": "AES256"
        },
        "Bool": { "aws:SecureTransport": "true" }
      }
    },
    {
      "Sid": "VerifyStoredBackups",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jump-in-the-mix-backups-602326733999-us-west-2/production/*",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    }
  ]
}
