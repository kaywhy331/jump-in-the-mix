{
  "name": "jump-in-the-mix-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, self-hosted MVP for Jump in the Mix.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:worker": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/worker/index.ts",
    "setup": "npm run db:generate && npm run db:setup",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:e2e-admin": "tsx scripts/seed-e2e-admin.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:setup:docker": "npm run db:deploy && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:rehearse-migration": "node scripts/rehearse-migration.mjs && node scripts/rehearse-admin-control-plane.mjs && node scripts/rehearse-admin-mfa.mjs && node scripts/rehearse-worker-heartbeat.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "db:smoke-restored": "node scripts/smoke-restored-database.mjs",
    "db:rehearse-restore": "node scripts/rehearse-backup-restore.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:syntax": "node scripts/validate-syntax.mjs",
    "validate:imports": "node scripts/validate-imports.mjs",
    "validate:static": "npm run validate:schema && npm run validate:syntax && npm run validate:imports",
    "check": "npm run db:generate && npm run validate:static && npm run typecheck && npm test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "quickstart:native": "node scripts/native-quickstart.mjs",
    "pilot:init": "node scripts/pilot.mjs init",
    "pilot:up": "node scripts/pilot.mjs up",
    "pilot:down": "node scripts/pilot.mjs down",
    "pilot:status": "node scripts/pilot.mjs status",
    "pilot:logs": "node scripts/pilot.mjs logs",
    "pilot:backup": "node scripts/pilot.mjs backup",
    "pilot:restore": "node scripts/pilot.mjs restore",
    "pilot:health": "node scripts/pilot.mjs health",
    "pilot:upgrade": "node scripts/pilot.mjs upgrade",
    "pilot:reset-password": "node scripts/pilot.mjs reset-password",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.2.11",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "web-push": "^3.6.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@prisma/prisma-schema-wasm": "7.9.0-1.e922089b7d7502aff4249d5da3420f6fa55fc6ad",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "3.6.4",
    "esbuild": "0.25.12",
    "prisma": "7.9.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.0"
  },
  "allowScripts": {
    "prisma@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.0": true
  }
}
