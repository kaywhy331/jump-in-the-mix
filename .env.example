# -----------------------------------------------------------------------------
# Jump in the Mix local configuration
# Development launchers copy this file and generate their required local keys.
# `npm run pilot:init` creates a production-like, demo-free pilot environment.
# Hosted authentication, notifications, and opt-in delivery remain disabled
# until their provider values are configured explicitly.
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
PILOT_MODE=false
APP_URL=http://localhost:3000
APP_PORT=3000
AUTH_COOKIE_NAME=jitm_session
AUTH_IMPERSONATION_COOKIE_NAME=jitm_impersonation
AUTH_SESSION_DAYS=14
AUTH_SESSION_TOUCH_MINUTES=5
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_IMPERSONATION_MINUTES=30
AUTH_IMPERSONATION_TOUCH_MINUTES=5
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Defaults to true in production and false in development when omitted.
AUTH_REQUIRE_ADMIN_MFA=false
# Administrator step-up remains valid for this many minutes per authenticated session.
AUTH_ADMIN_MFA_MAX_AGE_MINUTES=720
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_PASSWORD_RESET_MINUTES=60
AUTH_RATE_LIMIT_SECRET=GENERATE_ME
# Comma-separated extra trusted browser origins. Same-origin requests are allowed automatically.
AUTH_ALLOWED_ORIGINS=
# Required before storing sensitive application data or support-access TOTP secrets. Use a unique high-entropy production secret.
DATA_ENCRYPTION_KEY=GENERATE_ME
PLATFORM_ADMIN_EMAILS=

# Local demo experience
DEMO_MODE=true
DEMO_USER_EMAIL=demo@jumpinthemix.local
DEMO_USER_PASSWORD=JumpInTheMix123!
RESET_DEMO_DATA=false

# PostgreSQL
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_PORT=5432
# For native npm development use localhost. Docker Compose overrides this value.
DATABASE_URL=postgresql://jitm:GENERATE_ME@localhost:5432/jitm?schema=public

# Operations, backup, restore, and staging qualification
# Dedicated AES-256-GCM key for backup archives. Do not reuse DATA_ENCRYPTION_KEY.
# Use 64 hexadecimal characters or base64-encoded 32-byte material.
BACKUP_ENCRYPTION_KEY=GENERATE_ME
BACKUP_DIR=.backups
BACKUP_RETENTION_DAYS=30
# Restore always targets a separate empty database and intentionally blocks in-place restores.
RESTORE_DATABASE_URL=
# Optional generic JSON webhook for backup, restore, load-smoke, and staging-smoke failures.
OPS_ALERT_WEBHOOK_URL=
# Run ops:watch independently of the web and worker processes, on a supervised host.
# Keep its state and receipt files on private durable storage.
OPS_MONITOR_STATE_FILE=.operations/monitor-state.json
OPS_MONITOR_INTERVAL_SECONDS=300
OPS_MONITOR_STALE_SECONDS=900
OPS_JOB_OVERDUE_SECONDS=900
# Set this to the actual database storage allowance in bytes; 0 means unknown.
OPS_DATABASE_LIMIT_BYTES=0
OPS_BACKUP_RECEIPT_FILE=.operations/backup-receipt.json
OPS_RESTORE_RECEIPT_FILE=.operations/restore-receipt.json
OPS_BACKUP_MAX_AGE_HOURS=36
OPS_RESTORE_MAX_AGE_DAYS=30
OPS_SUPPORT_VIEWS_PER_HOUR=10
WORKER_HEARTBEAT_STALE_SECONDS=90
# Enable after-response queue wakeups only on Netlify, with its worker secret.
WORKER_DISPATCH_MODE=off
STAGING_BASE_URL=
STAGING_SMOKE_USER_EMAIL=
STAGING_SMOKE_USER_PASSWORD=
# Bounded load probe. Non-local targets additionally require LOAD_TEST_ACKNOWLEDGE=true.
LOAD_SMOKE_URL=
LOAD_SMOKE_MODE=health
# Customer mode: private chmod-600 JSON file bound to the exact target origin.
# See docs/CUSTOMER_LOAD_QUALIFICATION.md. Never put cookies in the command line.
LOAD_SMOKE_ACCOUNTS_FILE=
LOAD_SMOKE_DURATION_SECONDS=15
LOAD_SMOKE_CONCURRENCY=5
LOAD_SMOKE_MAX_REQUESTS=5000
LOAD_SMOKE_MAX_ERROR_RATE=0.01
LOAD_SMOKE_MAX_P95_MS=1000
LOAD_TEST_ACKNOWLEDGE=false

# Transactional email. Required before AUTH_REQUIRE_EMAIL_VERIFICATION=true in production.
RESEND_API_KEY=
# Optional server-only key with permission to retrieve sent email for admin recovery.
# When blank, receipt verification uses RESEND_API_KEY (if it has that permission).
RESEND_RECOVERY_API_KEY=
RESEND_WEBHOOK_SECRET=
# Rolling attempt limits below Resend Free's allowance; retries count conservatively.
EMAIL_DAILY_LIMIT=90
EMAIL_MONTHLY_LIMIT=2700
# Aggregate reports exclude demo_user and staff-only accounts automatically.
# Optional comma-separated internal/test accounts (at most 100 per list).
# Exclusions affect growth/activity metrics; email and storage usage include all traffic.
REPORT_EXCLUDED_USER_IDS=
REPORT_EXCLUDED_EMAILS=
EMAIL_DAILY_AUTH_RESERVE=20
EMAIL_MONTHLY_AUTH_RESERVE=300
EMAIL_FROM=Jump in the Mix <hello@localhost>
EMAIL_REPLY_TO=
# Generate one VAPID key pair per environment for Web Push.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:hello@jumpinthemix.app
# Optional, explicit customer-message delivery. Automatic sending stays off until enabled in Settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
# Use literal \\n sequences for line breaks when your host requires a single-line value.
AUTH_APPLE_PRIVATE_KEY=
# Public notices: supply the real operator, a monitored mailbox, and the actual
# backup retention/deletion procedure before hosted production can be ready.
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_BACKUP_RETENTION_NOTICE=
