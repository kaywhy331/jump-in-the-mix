# -----------------------------------------------------------------------------
# Jump in the Mix local configuration
# The quick-start scripts copy this file to .env and generate secure local keys.
# External integrations can remain blank while testing the core application.
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
AUTH_COOKIE_NAME=jitm_session
AUTH_IMPERSONATION_COOKIE_NAME=jitm_impersonation
AUTH_SESSION_DAYS=30
AUTH_SESSION_TOUCH_MINUTES=5
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_IMPERSONATION_MINUTES=30
AUTH_IMPERSONATION_TOUCH_MINUTES=5
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Defaults to true in production and false in development when omitted.
AUTH_REQUIRE_ADMIN_MFA=false
# Administrator step-up remains valid for this many minutes per authenticated session.
AUTH_ADMIN_MFA_MAX_AGE_MINUTES=720
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_PASSWORD_RESET_MINUTES=60
AUTH_RATE_LIMIT_SECRET=GENERATE_ME
# Comma-separated extra trusted browser origins. Same-origin requests are allowed automatically.
AUTH_ALLOWED_ORIGINS=
# Required before storing sensitive application data or support-access TOTP secrets. Use a unique high-entropy production secret.
DATA_ENCRYPTION_KEY=GENERATE_ME
PLATFORM_ADMIN_EMAILS=

# Local demo experience
DEMO_MODE=true
DEMO_USER_EMAIL=demo@jumpinthemix.local
DEMO_USER_PASSWORD=JumpInTheMix123!
RESET_DEMO_DATA=false

# PostgreSQL
POSTGRES_PASSWORD=jitm
POSTGRES_PORT=5432
# For native npm development use localhost. Docker Compose overrides this value.
DATABASE_URL=postgresql://jitm:jitm@localhost:5432/jitm?schema=public

# Operations, backup, restore, and staging qualification
# Dedicated AES-256-GCM key for backup archives. Do not reuse DATA_ENCRYPTION_KEY.
# Use 64 hexadecimal characters or base64-encoded 32-byte material.
BACKUP_ENCRYPTION_KEY=GENERATE_ME
BACKUP_DIR=.backups
BACKUP_RETENTION_DAYS=30
# Restore always targets a separate empty database and intentionally blocks in-place restores.
RESTORE_DATABASE_URL=
# Optional generic JSON webhook for backup, restore, load-smoke, and staging-smoke failures.
OPS_ALERT_WEBHOOK_URL=
WORKER_HEARTBEAT_STALE_SECONDS=90
STAGING_BASE_URL=
STAGING_SMOKE_USER_EMAIL=
STAGING_SMOKE_USER_PASSWORD=
# Bounded load probe. Non-local targets additionally require LOAD_TEST_ACKNOWLEDGE=true.
LOAD_SMOKE_URL=
LOAD_SMOKE_DURATION_SECONDS=15
LOAD_SMOKE_CONCURRENCY=5
LOAD_SMOKE_MAX_REQUESTS=5000
LOAD_SMOKE_MAX_ERROR_RATE=0.01
LOAD_SMOKE_MAX_P95_MS=1000
LOAD_TEST_ACKNOWLEDGE=false

# Transactional email. Required before AUTH_REQUIRE_EMAIL_VERIFICATION=true in production.
RESEND_API_KEY=
EMAIL_FROM=Jump in the Mix <hello@localhost>
EMAIL_REPLY_TO=
