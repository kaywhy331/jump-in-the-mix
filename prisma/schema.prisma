generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
}

enum ContactSource {
  MANUAL
  CSV
  WEBSITE
  WHATSAPP
  API
}

enum DateRecurrence {
  NONE
  MONTHLY
  YEARLY
}

enum Channel {
  SMS
  EMAIL
  PHONE_CALL
  VOICEMAIL
  WHATSAPP
}

enum MixStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MixTriggerMode {
  DATE_TRIGGERED
  MANUAL_START
  BROADCAST
}

enum AssignmentMode {
  SNAPSHOT
  DYNAMIC
}

enum JumpStatus {
  PENDING
  DONE
  SKIPPED
  CANCELED
}

enum SharedMixStatus {
  APPROVED
  UNPUBLISHED
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  assignedSupportTickets SupportTicket[] @relation("SupportAssignee")
  reportExports ReportExport[]
  staffMembership StaffMembership?
  referralInvitesIssued Int @default(0)
  sentAccessInvites ReferralAccessInvite[] @relation("AccessInviter")
  acceptedAccessInvite ReferralAccessInvite? @relation("AccessRecipient")
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  name            String
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  accessRevision  Int               @default(0)
  isPlatformAdmin Boolean           @default(false)
  sessions        Session[]
  authIdentities  AuthIdentity[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  auditLogs       AuditLog[]        @relation("AuditActor")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Session {
  supportViews AdminImpersonation[]
  reportExports ReportExport[]
  pushSubscriptions PushSubscription[]
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model Workspace {
  accessInvites ReferralAccessInvite[]
  journeyPreference      JourneyPreference?
  journeyStages          JourneyStage[]
  journeyRules           JourneyRule[]
  contactJourneys        ContactJourney[]
  journeyEvents          JourneyEvent[]
  intakeConnections      IntakeConnection[]
  calendarPreference     CalendarPreference?
  calendarConnections    CalendarConnection[]
  calendarEntries        CalendarEntry[]
  id                     String                         @id @default(cuid())
  name                   String
  slug                   String                         @unique
  ownerId                String
  owner                  User                           @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                WorkspaceMember[]
  profile                WorkspaceProfile?
  marketingPreference    WorkspaceMarketingPreference?
  contacts               Contact[]
  groups                 Group[]
  dateTypes              DateType[]
  jumpDates              JumpDate[]
  stepTemplates          StepTemplate[]
  mixes                  Mix[]
  mixAssignments         MixAssignment[]
  jumps                  Jump[]
  importedSharedMixes    SharedMixImport[]
  idempotencyKeys        IdempotencyKey[]
  jobs                   Job[]
  auditLogs              AuditLog[]
  customFieldDefinitions ContactCustomFieldDefinition[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceProfile {
  workspaceId    String    @id
  industry       String?
  primaryGoal    String?
  company        String?
  website        String?
  phone          String?
  street         String?
  city           String?
  state          String?
  postalCode     String?
  mailingAddress String?
  product1       String?
  product2       String?
  product3       String?
  product4       String?
  product5       String?
  myCustom1      String?
  myCustom2      String?
  myCustom3      String?
  products       Json?
  senderDetails  Json?
  smsSignature   String?
  emailSignature String?
  reviewUrl      String?
  onboardingStep Int       @default(0)
  onboardingDone Boolean   @default(false)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WorkspaceMarketingPreference {
  workspaceId String @id
  scenario String
  version Int
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  accessInvites ReferralAccessInvite[]
  journey             ContactJourney?
  journeyEvents       JourneyEvent[]
  intakeReceipts      IntakeReceipt[]
  intakeIdentities    IntakeIdentity[]
  calendarEntries     CalendarEntry[]
  id                  String                    @id @default(cuid())
  workspaceId         String
  firstName           String?
  lastName            String?
  displayName         String
  company             String?
  publicNotes         String?
  privateNotes        String?
  source              ContactSource             @default(MANUAL)
  referredByContactId String?
  archivedAt          DateTime?
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  referredBy          Contact?                  @relation("ContactReferrals", fields: [referredByContactId], references: [id], onDelete: SetNull)
  referrals           Contact[]                 @relation("ContactReferrals")
  emails              ContactEmail[]
  phones              ContactPhone[]
  addresses           ContactAddress[]
  groupMemberships    ContactGroupMembership[]
  jumpDates           JumpDate[]
  mixAssignments      MixAssignment[]
  jumps               Jump[]
  customFieldValues   ContactCustomFieldValue[]
  relationshipState   ContactRelationshipState?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([workspaceId, displayName])
  @@index([workspaceId, company])
  @@index([workspaceId, archivedAt])
  @@index([referredByContactId])
}

model ContactEmail {
  id         String   @id @default(cuid())
  contactId  String
  email      String
  normalized String
  isPrimary  Boolean  @default(false)
  label      String?
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([contactId, normalized])
  @@index([normalized])
}

model ContactPhone {
  id         String   @id @default(cuid())
  contactId  String
  phone      String
  normalized String
  isPrimary  Boolean  @default(false)
  label      String?
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([contactId, normalized])
  @@index([normalized])
}

model ContactAddress {
  id         String   @id @default(cuid())
  contactId  String
  label      String?
  street1    String?
  street2    String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  isPrimary  Boolean  @default(false)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model ContactCustomFieldDefinition {
  id          String                    @id @default(cuid())
  workspaceId String
  name        String
  key         String
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values      ContactCustomFieldValue[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([workspaceId, key])
}

model ContactCustomFieldValue {
  id           String                       @id @default(cuid())
  contactId    String
  definitionId String
  value        String
  contact      Contact                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definition   ContactCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([contactId, definitionId])
}

model Group {
  id          String                   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships ContactGroupMembership[]
  assignments MixAssignment[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([workspaceId, name])
}

model ContactGroupMembership {
  id        String   @id @default(cuid())
  contactId String
  groupId   String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([contactId, groupId])
  @@index([groupId])
}

model DateType {
  id          String     @id @default(cuid())
  workspaceId String?
  scopeKey    String
  name        String
  slug        String
  isSystem    Boolean    @default(false)
  isActive    Boolean    @default(true)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jumpDates   JumpDate[]
  mixes       Mix[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([scopeKey, slug])
  @@index([workspaceId, isActive])
}

model JumpDate {
  id          String         @id @default(cuid())
  workspaceId String
  contactId   String
  dateTypeId  String
  dateValue   DateTime?
  month       Int?
  day         Int?
  timeMinutes Int?
  recurrence  DateRecurrence @default(NONE)
  timezone    String
  label       String?
  source      ContactSource  @default(MANUAL)
  externalId  String?
  isActive    Boolean        @default(true)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dateType    DateType       @relation(fields: [dateTypeId], references: [id], onDelete: Restrict)
  jumps       Jump[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, dateTypeId, isActive])
  @@index([contactId])
}

model StepTemplate {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  channel        Channel
  isActive       Boolean       @default(true)
  currentVersion Int           @default(1)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions       StepVersion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId, channel, isActive])
}

model StepVersion {
  id             String       @id @default(cuid())
  stepTemplateId String
  version        Int
  subject        String?
  body           String?
  script         String?
  longSms        Boolean      @default(false)
  includeOptOut  Boolean      @default(false)
  stepTemplate   StepTemplate @relation(fields: [stepTemplateId], references: [id], onDelete: Cascade)
  mixSteps       MixStep[]
  jumps          Jump[]
  createdAt      DateTime     @default(now())

  @@unique([stepTemplateId, version])
}

model Mix {
  journeyStages             JourneyStage[]
  id                        String          @id @default(cuid())
  workspaceId               String
  name                      String
  description               String?
  framework                 String?
  category                  String?
  industry                  String?
  triggerMode               MixTriggerMode
  dateTypeId                String?
  status                    MixStatus       @default(DRAFT)
  durationDays              Int?
  includeFutureGroupMembers Boolean         @default(false)
  source                    String          @default("USER")
  workspace                 Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dateType                  DateType?       @relation(fields: [dateTypeId], references: [id], onDelete: SetNull)
  steps                     MixStep[]
  assignments               MixAssignment[]
  jumps                     Jump[]
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, dateTypeId])
}

model MixStep {
  id              String      @id @default(cuid())
  mixId           String
  stepVersionId   String
  dayOffset       Int
  sortOrder       Int
  sendTimeMinutes Int?
  isActive        Boolean     @default(true)
  mix             Mix         @relation(fields: [mixId], references: [id], onDelete: Cascade)
  stepVersion     StepVersion @relation(fields: [stepVersionId], references: [id], onDelete: Restrict)
  jumps           Jump[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([mixId, isActive, sortOrder])
  @@index([mixId, dayOffset])
}

model MixAssignment {
  id            String         @id @default(cuid())
  assignmentKey String         @unique
  workspaceId   String
  mixId         String
  contactId     String?
  groupId       String?
  startDate     DateTime?
  mode          AssignmentMode @default(SNAPSHOT)
  isActive      Boolean        @default(true)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mix           Mix            @relation(fields: [mixId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId, mixId, isActive])
  @@index([contactId])
  @@index([groupId])
}

model Jump {
  id               String                 @id @default(cuid())
  workspaceId      String
  contactId        String
  jumpDateId       String?
  mixId            String
  mixStepId        String
  stepVersionId    String
  scheduledAt      DateTime
  status           JumpStatus             @default(PENDING)
  reason           String
  templateSnapshot Json
  renderedSnapshot Json
  completedAt      DateTime?
  completionMethod String?
  uniquenessKey    String                 @unique
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jumpDate         JumpDate?              @relation(fields: [jumpDateId], references: [id], onDelete: SetNull)
  mix              Mix                    @relation(fields: [mixId], references: [id], onDelete: Cascade)
  mixStep          MixStep                @relation(fields: [mixStepId], references: [id], onDelete: Cascade)
  stepVersion      StepVersion            @relation(fields: [stepVersionId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  pushDeliveries   FollowUpPushDelivery[]

  @@index([workspaceId, scheduledAt, status])
  @@index([workspaceId, status, completedAt])
  @@index([contactId, scheduledAt])
  @@index([mixId])
  @@index([mixStepId])
  @@index([stepVersionId])
}

model SharedMix {
  revisions    SharedMixRevision[]
  releases     SharedMixRelease[]
  id           String            @id @default(cuid())
  title        String
  description  String
  category     String
  industry     String?
  framework    String?
  durationDays Int
  steps        Json
  status       SharedMixStatus   @default(APPROVED)
  importCount  Int               @default(0)
  imports      SharedMixImport[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, category])
  @@index([industry])
}

model SharedMixImport {
  id          String    @id @default(cuid())
  importKey   String    @unique
  workspaceId String
  sharedMixId String
  mixId       String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sharedMix   SharedMix @relation(fields: [sharedMixId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, sharedMixId])
}

model IdempotencyKey {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  response    Json?
  expiresAt   DateTime
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, key])
  @@index([expiresAt])
}

model Job {
  reportExport ReportExport?
  reportSnapshot ReportDailySnapshot?
  id          String     @id @default(cuid())
  workspaceId String?
  task        String
  payload     Json
  runAt       DateTime   @default(now())
  attempts    Int        @default(0)
  maxAttempts Int        @default(8)
  lockedAt    DateTime?
  lockedBy    String?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([runAt, completedAt, failedAt])
  @@index([workspaceId, task])
}

model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  source      String
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser   User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model AccountDeletionAudit {
  id          String    @id @default(cuid())
  requestId   String    @unique
  subjectHash String
  status      String
  metadata    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([subjectHash, createdAt])
  @@index([status, createdAt])
}

// Issued invitations consume a lifetime slot even if revoked or the contact is deleted.
model ReferralAccessInvite {
  id              String    @id @default(cuid())
  inviterUserId   String?
  workspaceId     String?
  contactId       String?
  recipientEmail  String
  lastSentAt      DateTime?
  tokenHash       String    @unique
  tokenCiphertext String
  tokenPurgedAt   DateTime?
  acceptedUserId  String?   @unique
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  source          AccessInviteSource @default(REFERRAL)
  systemMixVersion Int?
  marketingScenario String?
  marketingScenarioVersion Int?
  waveId          String?
  wave            WaitlistWave? @relation(fields: [waveId], references: [id], onDelete: SetNull)
  delivery        WaitlistDelivery?
  inviter         User?     @relation("AccessInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  recipient       User?     @relation("AccessRecipient", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([inviterUserId, contactId])
  @@index([workspaceId, createdAt])
  @@index([recipientEmail, acceptedAt, revokedAt])
  @@index([tokenPurgedAt, createdAt])
}

enum AccessInviteSource {
  REFERRAL
  WAITLIST_FIFO
  WAITLIST_RANDOM
  WAITLIST_MANUAL
}

enum WaitlistStatus {
  WAITING
  ACCESS_GRANTED
  JOINED
  WITHDRAWN
  SUPPRESSED
}

model WaitlistEntry {
  id              String @id @default(cuid())
  email           String @unique
  status          WaitlistStatus @default(WAITING)
  verifiedAt      DateTime?
  accessGrantedAt DateTime?
  joinedAt        DateTime?
  withdrawnAt     DateTime?
  marketingScenario String?
  marketingScenarioVersion Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, verifiedAt, createdAt])
}

enum EmailSuppressionReason {
  INVITATION_OPTOUT
  HARD_BOUNCE
  COMPLAINT
  PROVIDER_SUPPRESSION
}

// Recipient preferences survive removal from the queue and cannot be overridden by a sender.
model EmailSuppression {
  id        String @id @default(cuid())
  email     String
  reason    EmailSuppressionReason
  createdAt DateTime @default(now())
  revision Int @default(1)
  lastTriggeredAt DateTime?
  clearedAt DateTime?

  @@unique([email, reason])
  @@index([clearedAt, createdAt])
}

// Singleton schedule. Restarts never reset the seven-day clock.
model WaitlistSchedule {
  id        String @id @default("default")
  nextRunAt DateTime
  paused    Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model WaitlistWave {
  id           String @id @default(cuid())
  scheduledFor DateTime @unique
  fifoCount    Int @default(0)
  randomCount  Int @default(0)
  createdAt    DateTime @default(now())
  invites      ReferralAccessInvite[]
}

enum WaitlistDeliveryStatus {
  QUEUED
  SENDING
  SENT
  REVIEW
  CANCELED
}

// Durable email outbox; frozen encrypted content keeps provider retries identical.
model WaitlistDelivery {
  id                String @id @default(cuid())
  inviteId          String? @unique
  invite            ReferralAccessInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  staffInvitationId String? @unique
  staffInvitation   StaffInvitation? @relation(fields: [staffInvitationId], references: [id], onDelete: Cascade)
  messageCiphertext String
  payloadPurgedAt   DateTime?
  status            WaitlistDeliveryStatus @default(QUEUED)
  generation        Int @default(1)
  generationStartedAt DateTime @default(now())
  history           InvitationDeliveryHistory[]
  attempts          Int @default(0)
  firstAttemptAt    DateTime?
  nextAttemptAt     DateTime @default(now())
  leaseId           String?
  lockedAt          DateTime?
  providerId        String?
  emailMessageId    String? @unique
  emailMessage      EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([payloadPurgedAt, updatedAt])
}

// Platform records intentionally survive customer/workspace deletion. No tokens or email bodies.
model WaitlistAudit {
  id          String @id @default(cuid())
  actorUserId String?
  action      String
  entryId     String?
  inviteId    String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
