enum ContactPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ContactRelationshipState {
  id                 String          @id @default(cuid())
  workspaceId        String
  contactId          String          @unique
  preferredChannel   Channel?
  priority           ContactPriority @default(NORMAL)
  doNotContact       Boolean         @default(false)
  relationshipStatus String?
  nextCommitmentAt   DateTime?
  // When the owner confirmed this person needs no Mix. It counts only while no Mix has started for them
  // since; joining a Mix makes it lapse without a write (JITM-09 §2.76).
  noMixNeededAt      DateTime?
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  contact            Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)


  @@index([workspaceId, priority])
  @@index([workspaceId, doNotContact])
  @@index([workspaceId, nextCommitmentAt])
}

model ContactSavedView {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  query       Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)


  @@unique([userId, workspaceId, name])
  @@index([workspaceId, userId, createdAt])
}

model ContactMergeRecord {
  id                String   @id @default(cuid())
  workspaceId       String
  survivorContactId String
  mergedContactId   String
  actorUserId       String
  sourceSnapshot    Json
  mergeSummary      Json
  createdAt         DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survivorContact Contact @relation("ContactMergeSurvivor", fields: [survivorContactId], references: [id], onDelete: Cascade)
  mergedContact   Contact @relation("ContactMergeMerged", fields: [mergedContactId], references: [id], onDelete: Cascade)
  actor           User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)


  @@index([workspaceId, createdAt])
  @@index([survivorContactId])
  @@index([mergedContactId])
}
