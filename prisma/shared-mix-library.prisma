model SharedMixMetadata {
  sharedMixId  String         @id
  sourceMixId  String?
  triggerMode  MixTriggerMode @default(MANUAL_START)
  dateTypeName String?
  dateTypeSlug String?
  version      Int            @default(1)
  featuredAt   DateTime?
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([featuredAt, publishedAt])
}

model SharedMixImportMetadata {
  importId         String   @id
  sharedMixVersion Int      @default(1)
  createdAt        DateTime @default(now())
}
