model AuthRateLimit {
  id              String   @id @default(cuid())
  key             String   @unique
  scope           String
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, updatedAt])
  @@index([blockedUntil])
}

model AuthIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model AuthOAuthState {
  id           String       @id @default(cuid())
  provider     AuthProvider
  stateHash    String       @unique
  codeVerifier String
  nonce        String
  returnTo     String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([provider, expiresAt])
}

model AdminImpersonation {
  id           String   @id @default(cuid())
  ticketId     String?
  actorSessionId String?
  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actorSession Session? @relation(fields: [actorSessionId], references: [id], onDelete: SetNull)
  tokenHash    String   @unique
  actorUserId  String
  targetUserId String
  workspaceId  String
  reason       String
  expiresAt    DateTime
  endedAt      DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([actorUserId, expiresAt])
  @@index([targetUserId, workspaceId, expiresAt])
  @@index([workspaceId, endedAt])
  @@index([ticketId, endedAt])
  @@index([actorSessionId])
}

model AdminMfaCredential {
  userId                String   @id
  secretCiphertext      String
  recoveryCodeHashes    String[] @default([])
  enabledAt             DateTime?
  lastUsedCounter       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabledAt])
}

model AdminMfaSession {
  sessionId  String   @id
  userId     String
  verifiedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
