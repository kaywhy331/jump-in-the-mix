model AuthRateLimit {
  id              String   @id @default(cuid())
  key             String   @unique
  scope           String
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, updatedAt])
  @@index([blockedUntil])
}
