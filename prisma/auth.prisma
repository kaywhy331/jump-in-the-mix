model AuthRateLimit {
  id              String   @id @default(cuid())
  key             String   @unique
  scope           String
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, updatedAt])
  @@index([blockedUntil])
}

model AdminImpersonation {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  actorUserId  String
  targetUserId String
  workspaceId  String
  reason       String
  expiresAt    DateTime
  endedAt      DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([actorUserId, expiresAt])
  @@index([targetUserId, workspaceId, expiresAt])
  @@index([workspaceId, endedAt])
}

model AdminMfaCredential {
  userId                String   @id
  secretCiphertext      String
  recoveryCodeHashes    String[] @default([])
  enabledAt             DateTime?
  lastUsedCounter       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabledAt])
}

model AdminMfaSession {
  sessionId  String   @id
  userId     String
  verifiedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
