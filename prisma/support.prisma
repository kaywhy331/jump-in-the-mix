enum SupportTicketCategory {
  GENERAL
  ACCOUNT
  CONTACTS
  JUMPS
  MIXES
  JUMP_DATES
  TEMPLATES
  IMPORTS_SYNC
  PRIVACY_SECURITY
  BUG
  FEATURE_REQUEST
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  WAITING_ON_SUPPORT
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorType {
  USER
  ADMIN
}

enum SupportEmailStatus {
  NOT_REQUESTED
  PENDING
  SENT
  PREVIEWED
  FAILED
}

model SupportTicket {
  id               String                @id @default(cuid())
  assignedToUserId String?
  assignmentRevision Int @default(0)
  assignedTo User? @relation("SupportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  supportViews AdminImpersonation[]
  reference        String                @unique
  workspaceId      String
  requesterUserId  String
  title            String
  category         SupportTicketCategory
  priority         SupportTicketPriority @default(NORMAL)
  status           SupportTicketStatus   @default(OPEN)
  lastActivityAt   DateTime              @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  closedAt         DateTime?
  messages         SupportTicketMessage[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([workspaceId, requesterUserId, lastActivityAt])
  @@index([status, priority, lastActivityAt])
  @@index([category, status])
  @@index([assignedToUserId, status])
  @@index([status, lastActivityAt])
}

model SupportTicketMessage {
  id              String                   @id @default(cuid())
  ticketId        String
  authorUserId    String
  authorType      SupportMessageAuthorType
  body            String
  requestKey      String?                  @unique
  emailDeliveries SupportEmailDelivery[]
  emailStatus     SupportEmailStatus       @default(NOT_REQUESTED)
  emailProviderId String?
  emailError      String?
  emailSentAt     DateTime?
  ticket          SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt       DateTime                 @default(now())

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([emailStatus, createdAt])
}

enum SupportEmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  REVIEW
  CANCELED
}

model SupportEmailDelivery {
  id                String @id @default(cuid())
  messageId         String
  message           SupportTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  generation        Int @default(1)
  status            SupportEmailDeliveryStatus @default(QUEUED)
  messageCiphertext String
  emailMessageId    String @unique
  issuerUserId      String
  issuerRevision    Int?
  attempts          Int @default(0)
  firstAttemptAt    DateTime?
  availableAt       DateTime @default(now())
  leaseId           String?
  leaseUntil        DateTime?
  providerId        String?
  acceptedAt        DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([messageId, generation])
  @@index([status, availableAt])
  @@index([status, leaseUntil])
}
