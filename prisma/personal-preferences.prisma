// Where people go when they are added (JITM-09 §2.78, D34): leave them out (No Mix), add them to a chosen Mix,
// or ask each time.
enum NewContactPlacement {
  NONE
  MIX
  ASK
}

enum WeekendScheduling {
  KEEP
  NEXT_MONDAY
  PREVIOUS_FRIDAY
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  locale    String   @default("en-US")
  timezone  String   @default("UTC")
  reviewMixActivation Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspacePreference {
  id                     String            @id @default(cuid())
  workspaceId            String            @unique
  defaultFollowUpMinutes Int               @default(600)
  quietHoursStart        Int               @default(1200)
  quietHoursEnd          Int               @default(480)
  weekendScheduling      WeekendScheduling @default(KEEP)
  // Minutes kept free before and after each appointment when checking for conflicts.
  appointmentBufferMinutes Int             @default(0)
  // Reviewed onboarding choices; null preserves existing scheduling behavior.
  journeyPreferences     Json?
  newContactPlacement    NewContactPlacement @default(NONE)
  // The Mix new people start when the placement is MIX; one that starts when the owner chooses.
  newContactMixId        String?
  newContactMix          Mix?              @relation("NewContactMix", fields: [newContactMixId], references: [id], onDelete: SetNull)
  quietDaysEnabled       Boolean           @default(false)
  quietDays              Int               @default(60)
  nextReconcileAt        DateTime          @default(now())
  lastReconciledAt       DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneRegion String @default("US") // ISO 3166-1 alpha-2 for numbers saved without a country code (CHECK in the migration)
}
